DATABASE_URL="file:./test.sqlite"
FRONTEND_URL=https://example.com

# The rate-limit tests fire 51 requests through supertest and expect a 429.
# These windows used to be 0.25s/0.1s, which was long enough on Node 16 but not
# on Node 24 -- the burst now spreads across several windows, so the limit never
# tripped even though rate limiting itself was fine. The burst measures ~0.7s,
# so 2s contains it. Tests that follow a rate-limit test must then wait out the
# window before making further requests -- see the sleeps in app.integration.test.ts,
# which are deliberately kept just above this value.
POST_LIMIT=50
POST_LIMIT_WINDOW_SECONDS=2
GET_LIMIT=20
GET_LIMIT_WINDOW_SECONDS=2
LOG_LEVEL=warn

# Make cleanup interval very long to avoid automatic cleanup during tests
CLEANUP_INTERVAL_SECONDS=99999
