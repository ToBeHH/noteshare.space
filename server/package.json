{
  "name": "obsidian-quickshare-server",
  "version": "0.0.1",
  "description": "Express + Prisma + SQLite app for hosting encrypted notes.",
  "main": "server.js",
  "scripts": {
    "test": "npm run test:db:reset && npm run test:test",
    "coverage": "npm run test:db:reset && npm run test:coverage",
    "test-watch": "dotenv -v UNIT_TEST=TRUE -e .env.test -- vitest unit",
    "test:test": "dotenv -e .env.test -- vitest run --no-file-parallelism",
    "test:coverage": "dotenv -e .env.test -- vitest run --coverage --no-file-parallelism",
    "test:db:reset": "dotenv -e .env.test -- prisma migrate reset -f",
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "migrate": "prisma migrate dev"
  },
  "author": "Maxime Cannoodt (mcndt)",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-sqlite3": "^13.0.3",
    "bloom-filters": "^3.0.4",
    "class-validator": "^0.15.1",
    "crc": "^4.3.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv-cli": "^10.0.0",
    "prisma": "^7.10.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "mysql2": "^3.24.4",
    "deepmerge-ts": "^8.0.2"
  }
}
